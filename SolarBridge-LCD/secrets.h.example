// Copy this file to secrets.h (same folder) and fill in real values to skip
// the WiFiManager captive portal on first boot — handy while developing on
// a bench. secrets.h is gitignored; never commit real credentials.
//
// This is entirely optional — leave it out and the board just falls back
// to the "SolarBridge-Setup" WiFi portal described in the README.

// Primary network — tried first at boot.
#define DEFAULT_WIFI_SSID "your-wifi-name"
#define DEFAULT_WIFI_PASS "your-wifi-password"
// Backup network (optional) — tried if primary fails to connect, and
// alternated with on every reconnect attempt while running. Leave both
// blank ("") if you only have one network.
#define DEFAULT_WIFI_SSID2 "your-backup-wifi-name"
#define DEFAULT_WIFI_PASS2 "your-backup-wifi-password"
#define DEFAULT_SERVER_URL "https://solar.yourdomain.com"
#define DEFAULT_API_TOKEN "paste-your-viewer-token-here"
// OTA password (optional but recommended) — required to push firmware over
// WiFi. Leave blank ("") to allow OTA with no password (fine for a bench,
// not recommended once the board's on your real network).
#define DEFAULT_OTA_PASSWORD "pick-an-ota-password"
